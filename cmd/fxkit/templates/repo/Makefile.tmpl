.PHONY: help build run tidy clean infra infra-down hatchet-token

VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
GIT_REMOTE ?= $(shell git config --get remote.origin.url 2>/dev/null || echo unknown)
GIT_BRANCH ?= $(shell git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)
COMMIT ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo unknown)
GIT_DIRTY ?= $(shell test -n "$$(git status --porcelain 2>/dev/null)" && echo true || echo false)
GO_VERSION ?= $(shell go version 2>/dev/null | awk '{print $$3}' || echo unknown)
BUILD_TIME ?= $(shell date -u +"%Y-%m-%dT%H:%M:%SZ")
BUILT_BY ?= $(shell whoami 2>/dev/null || echo unknown)

GO_LDFLAGS := -X 'github.com/fitan/fxkit/buildinfo.Version=$(VERSION)' \
	-X 'github.com/fitan/fxkit/buildinfo.Commit=$(COMMIT)' \
	-X 'github.com/fitan/fxkit/buildinfo.GitRemote=$(GIT_REMOTE)' \
	-X 'github.com/fitan/fxkit/buildinfo.GitBranch=$(GIT_BRANCH)' \
	-X 'github.com/fitan/fxkit/buildinfo.Dirty=$(GIT_DIRTY)' \
	-X 'github.com/fitan/fxkit/buildinfo.GoVersion=$(GO_VERSION)' \
	-X 'github.com/fitan/fxkit/buildinfo.BuildTime=$(BUILD_TIME)' \
	-X 'github.com/fitan/fxkit/buildinfo.BuiltBy=$(BUILT_BY)'

SERVICES := $(patsubst services/%/cmd,%,$(wildcard services/*/cmd))

help:
	@echo "make build          # build all services into bin/"
	@echo "make build SVC=foo  # build one service"
	@echo "make run SVC=foo    # run one service"
	@echo "make openapi SVC=foo# dump OpenAPI 3.0 YAML (no HTTP listen)"
	@echo "make infra          # start local middleware (postgres, hatchet, consul, otel)"
	@echo "make infra-down     # stop middleware (keep volumes)"
	@echo "make hatchet-token  # print a local Hatchet API token"
	@echo "make tidy"
	@echo "make clean"

build:
ifeq ($(SVC),)
	@test -n "$(SERVICES)" || (echo "no services yet; run: fxkit new <name>"; exit 1)
	@for s in $(SERVICES); do \
		echo "building $$s"; \
		go build -ldflags "$(GO_LDFLAGS)" -o bin/$$s ./services/$$s/cmd; \
	done
else
	go build -ldflags "$(GO_LDFLAGS)" -o bin/$(SVC) ./services/$(SVC)/cmd
endif

run:
	@test -n "$(SVC)" || (echo "usage: make run SVC=<name>"; exit 1)
	go run -ldflags "$(GO_LDFLAGS)" ./services/$(SVC)/cmd serve --config services/$(SVC)/configs/config.yaml

openapi:
	@test -n "$(SVC)" || (echo "usage: make openapi SVC=<name>"; exit 1)
	go run -ldflags "$(GO_LDFLAGS)" ./services/$(SVC)/cmd openapi --config services/$(SVC)/configs/config.yaml -o services/$(SVC)/openapi.yaml

infra:
	docker compose up -d

infra-down:
	docker compose down

hatchet-token:
	@docker compose exec hatchet /hatchet-admin token create --config /config --tenant-id 707d0855-80ab-4e1f-a156-f1c4546cbf52

tidy:
	go mod tidy

clean:
	rm -rf bin/
