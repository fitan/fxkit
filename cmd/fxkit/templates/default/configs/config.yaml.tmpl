server:
  port: "8080"
  log_payloads: false

app:
  name: "{{.AppName}}"

dapr:
  store_name: "statestore"
  pubsub_name: "pubsub"

discovery:
  consul_address: ""
  consul_passing_only: true

{{if .UseDB -}}
# Wire a database by setting driver+dsn (mysql | postgres | sqlite).
db:
  driver: ""
  dsn: ""
  log_level: "info"
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime_sec: 3600
{{- else -}}
db:
  driver: ""
  dsn: ""
{{- end }}

auth:
  enabled: false
  issuer: ""
  audience: ""
  jwks_url: ""
  org_claim: "organization_id"
  require_org: false
  dev_header_user: false

otel:
  enabled: false
  service_name: "{{.AppName}}"
  service_version: "0.1.0"
  environment: "development"
  endpoint: "localhost:4317"
  protocol: "grpc"
  insecure: true
  sampling: "always_on"
  traces:
    enabled: true
    exporter: "otlp"
  metrics:
    enabled: true
    exporter: "otlp"
    runtime_metrics: true
  logs:
    enabled: true
    exporter: "otlp"
