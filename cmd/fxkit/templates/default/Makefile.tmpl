.PHONY: build run dapr-run dapr-stop clean

VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
GIT_REMOTE ?= $(shell git config --get remote.origin.url 2>/dev/null || echo unknown)
GIT_BRANCH ?= $(shell git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)
COMMIT ?= $(shell git rev-parse --short HEAD 2>/dev/null || echo unknown)
GIT_DIRTY ?= $(shell test -n "$$(git status --porcelain 2>/dev/null)" && echo true || echo false)
GO_VERSION ?= $(shell go version 2>/dev/null | awk '{print $$3}' || echo unknown)
BUILD_TIME ?= $(shell date -u +"%Y-%m-%dT%H:%M:%SZ")
BUILT_BY ?= $(shell whoami 2>/dev/null || echo unknown)

GO_LDFLAGS := -X github.com/fitan/fxkit/buildinfo.Version=$(VERSION) \
	-X github.com/fitan/fxkit/buildinfo.Commit=$(COMMIT) \
	-X github.com/fitan/fxkit/buildinfo.GitRemote=$(GIT_REMOTE) \
	-X github.com/fitan/fxkit/buildinfo.GitBranch=$(GIT_BRANCH) \
	-X github.com/fitan/fxkit/buildinfo.Dirty=$(GIT_DIRTY) \
	-X github.com/fitan/fxkit/buildinfo.GoVersion=$(GO_VERSION) \
	-X github.com/fitan/fxkit/buildinfo.BuildTime=$(BUILD_TIME) \
	-X github.com/fitan/fxkit/buildinfo.BuiltBy=$(BUILT_BY)

build:
	go build -ldflags "$(GO_LDFLAGS)" -o bin/server ./cmd

run:
	go run -ldflags "$(GO_LDFLAGS)" ./cmd serve

dapr-run: dapr-stop build
	dapr run -f .

dapr-stop:
	@dapr stop -f . || true

clean:
	rm -rf bin/
